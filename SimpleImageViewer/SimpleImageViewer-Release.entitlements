<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Release distribution: no App Sandbox so in-place updates can rewrite Bundle.main.
	     Network client remains enabled for the version feed and zip download. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
